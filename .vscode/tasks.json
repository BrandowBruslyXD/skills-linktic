{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap skills-linktic",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/setup.sh\"",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ripor login manual",
      "type": "shell",
      "command": "bash -lc 'source \"${workspaceFolder}/.venv/bin/activate\" && python \"${workspaceFolder}/skills/registro-horas/registrar_horas.py\" --login-manual'",
      "problemMatcher": []
    },
    {
      "label": "Instalar desde cero (comando único)",
      "type": "shell",
      "command": "bash <(curl -fsSL https://raw.githubusercontent.com/BrandowBruslyXD/skills-linktic/main/install.sh)",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
